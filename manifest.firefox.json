{
  "name": "Chordwiki-Ex",
  "version": "1.0.19",
  "manifest_version": 3,
  "description": "日本語 ChordWiki（ja.chordwiki.org）のコード譜を、DOM 加工と CSS で読みやすく整えるブラウザ拡張。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://ja.chordwiki.org/wiki/*",
        "https://ja.chordwiki.org/wiki.cgi?c=view*"
      ],
      "css": [
        "quick-panel.css"
      ],
      "js": [
        "quick-panel.js",
        "layout-styles.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/MNotoSans-alpha-ExtraBold-v2.ttf"
      ],
      "matches": [
        "https://ja.chordwiki.org/*"
      ]
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html",
    "default_title": "Chordwiki-Ex"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "chordwiki-ex@xiace-lite",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
